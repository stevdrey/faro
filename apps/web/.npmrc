# Apply to every npm install/ci performed in apps/web.
# Block all dependency lifecycle code: preinstall/install/postinstall/prepare.
ignore-scripts=true

# Require reviewed/pinned package versions and enforce declared engine compatibility.
save-exact=true
engine-strict=true
strict-peer-deps=true
package-lock=true

# npm 12: delay adopting very recent versions for new resolutions.
# Production emergencies require a reviewed, narrow exception and a lockfile update.
min-release-age=3

# Deny dependencies that execute git or install external/local tarballs.
allow-git=none
allow-directory=none
allow-file=none
allow-remote=none

# Keep npm's vulnerability checks active.
audit=true
audit-level=high
strict-ssl=true
fund=false
